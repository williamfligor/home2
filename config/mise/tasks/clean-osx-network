#!/bin/bash
#MISE description="Reset macOS network locations (one-off maintenance)"
set -euo pipefail

# One-off macOS maintenance: recreate the network locations from scratch.
# Guarded so the shared task dir doesn't fail on non-macOS machines.
if ! command -v networksetup &>/dev/null; then
    echo "clean-osx-network: networksetup not found (not macOS?), skipping"
    exit 0
fi

networksetup -createlocation TempLoc populate
sleep 5
networksetup -switchtolocation TempLoc
sleep 2
networksetup -deletelocation Automatic
sleep 2
networksetup -createlocation Automatic populate
sleep 5
networksetup -switchtolocation Automatic
sleep 5
networksetup -deletelocation TempLoc
exit 0