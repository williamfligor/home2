#!/bin/bash
#MISE description="Fetch the grill-me skill (pinned SHA) into ~/.agents/skills (marker-guarded)"
# vi: ft=bash
set -euo pipefail

# Fetch the grill-me skill (a subdirectory of mattpocock/skills) into
# ~/.agents/skills/grill-me. bootstrap.repos can only clone whole repos, so this
# uses the codeload tarball + tar --strip-components=4 + the grill-me subtree.
# Idempotent/refresh-safe: a marker file holds the pinned commit; bump SHA below
# to refresh (mirrors the old 168h refreshPeriod; MIGRATION.md decision #4).

SHA="2ab958093e83e0ec752e6c1c5932da465bf23e0c"
DEST="$HOME/.agents/skills/grill-me"
MARK="$DEST/.bootstrap-sha"

if [[ -f "$MARK" ]] && [[ "$(cat "$MARK")" == "$SHA" ]]; then
  echo "grill-me: up to date ($SHA)"
  exit 0
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "grill-me: fetching $SHA"
curl -fsSL "https://codeload.github.com/mattpocock/skills/tar.gz/$SHA" -o "$TMP/skills.tgz"
mkdir "$TMP/full"
tar -xzf "$TMP/skills.tgz" -C "$TMP/full"

# Locate the grill-me subtree (in tarball: skills/productivity/grill-me) and
# copy its CONTENTS flat into the skill dir — matches the old chezmoi
# `include=["**/grill-me/**"] + stripComponents=4` layout (SKILL.md at root).
GRILL_DIR="$(find "$TMP/full" -type d -name grill-me | head -1)"
if [[ -z "$GRILL_DIR" ]]; then
  echo "grill-me: grill-me/ dir not found in tarball" >&2
  exit 1
fi

mkdir -p "$(dirname "$DEST")"
rm -rf "$DEST"
mkdir -p "$DEST"
(cd "$GRILL_DIR" && cp -a . "$DEST/")
echo "$SHA" > "$MARK"
echo "grill-me: installed to $DEST"