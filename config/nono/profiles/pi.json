{
  "extends": "nolabs-ai/pi",
  "meta": {
    "name": "pi",
    "version": "1.1.0",
    "description": "Pi agent profile: upstream nolabs-ai/pi plus mise runtime and Git/SSH access"
  },
  "groups": {
    "include": ["mise_manager", "linux_temp_read"]
  },
  "filesystem": {
    "allow": [
      "$HOME/.config/orca/agent-hooks"
    ],
    "read": [
      "$HOME/.ssh"
    ],
    "bypass_protection": [
      "$HOME/.ssh"
    ]
  },
  "platform_overrides": {
    "linux": {
      "filesystem": {
        "read_file": [
          "/etc/passwd",
          "/etc/group"
        ]
      }
    }
  }
}
