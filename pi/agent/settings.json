{
  "defaultProvider": "opencode-go",
  "defaultModel": "gpt-5.6-luna",
  "theme": "light",
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 19200,
    "keepRecentTokens": 19200
  },
  "retry": {
    "enabled": true,
    "maxRetries": 99
  },
  "lastChangelogVersion": "1.0.0",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@howaboua/pi-skill-anti-ai-copy",
    "npm:@richardgill/pi-background-bash",
    "npm:pi-powerline-footer",
    "npm:pi-rewind",
    "npm:pi-smart-fetch",
    "npm:pi-subagents",
    "npm:pi-vimmode",
    {
      "source": "~/.config/nono/packages/nolabs-ai/pi"
    },
    "npm:pi-goal-x"
  ],
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "enabledModels": [
    "opencode-go/*",
    "llama-cpp/*"
  ],
  "powerline": {
    "preset": "default",
    "welcome": false,
    "mouseScroll": true,
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "context_pct",
        "cost",
        "git"
      ],
      "right": [],
      "secondary": [
        "extension_statuses"
      ]
    }
  },
  "showHardwareCursor": true,
  "tuiMode": "regular",
  "showCacheMissNotices": true
}
